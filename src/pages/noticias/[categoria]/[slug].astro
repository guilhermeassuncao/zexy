---
import { getCollection, render } from "astro:content";
import ZxLayout from "../../../layouts/ZxLayout.astro";
import { noticiaCategoryLabels } from "../../../data/catalog";

export async function getStaticPaths() {
  const entries = await getCollection("noticias");
  return entries.map((entry) => ({
    params: { categoria: entry.data.category, slug: entry.slug },
    props: { entry }
  }));
}

const { entry } = Astro.props;
const post = entry.data;
const { Content } = await render(entry);

const site = Astro.site ?? new URL("https://zexy.com.br");
const canonicalUrl = new URL(Astro.url.pathname, site).toString();
const publishedTime = post.publishedAt.toISOString();
const modifiedTime = (post.updatedAt ?? post.publishedAt).toISOString();
const author = post.author ?? "Equipe Zexy";
const description = post.description ?? post.title;
const categoryLabel = noticiaCategoryLabels[post.category];
const dateLabel = post.publishedAt.toLocaleDateString("pt-BR", { day: "2-digit", month: "long", year: "numeric", timeZone: "UTC" });

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    headline: post.title,
    description,
    image: [new URL(post.image, site).toString()],
    datePublished: publishedTime,
    dateModified: modifiedTime,
    author: { "@type": "Organization", name: author },
    publisher: {
      "@type": "Organization",
      name: "Zexy",
      logo: { "@type": "ImageObject", url: new URL("/favicon.svg", site).toString() }
    },
    mainEntityOfPage: canonicalUrl,
    keywords: post.tags?.join(", ")
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Zexy", item: site.toString() },
      { "@type": "ListItem", position: 2, name: "Notícias", item: new URL("/noticias/", site).toString() },
      { "@type": "ListItem", position: 3, name: post.title, item: canonicalUrl }
    ]
  }
];
---

<ZxLayout
  title={`${post.title} | Zexy`}
  description={description}
  image={post.image}
  structuredData={structuredData}
>
  <article class="zx-container pt-28 pb-16 max-md:pt-24">
    <header class="mx-auto max-w-3xl text-center">
      <nav aria-label="Você está aqui" class="mb-6 text-sm text-zx-muted">
        <a href="/noticias" class="hover:text-zx-ink">Notícias</a>
        <span aria-hidden="true"> / </span>
        <span class="text-zx-ink">{categoryLabel}</span>
      </nav>
      <h1 class="zx-title text-3xl sm:text-4xl md:text-5xl">{post.title}</h1>
      <p class="mt-4 text-base leading-7 text-zx-muted">{description}</p>
      <p class="mt-4 text-sm text-zx-muted">
        Por {author} · <time datetime={publishedTime}>{dateLabel}</time>
      </p>
    </header>

    <div class="mx-auto mt-10 max-w-3xl overflow-hidden rounded-2xl border border-zx-line">
      <img
        src={post.image}
        alt={post.alt ?? post.title}
        width="1200"
        height="675"
        loading="eager"
        decoding="async"
        class="aspect-video w-full object-cover"
      />
    </div>

    <div class="post-content mx-auto mt-10 max-w-3xl">
      <Content />
    </div>

    <p class="mx-auto mt-12 max-w-3xl">
      <a href="/noticias" class="zx-btn-ghost">← Ver todas as notícias</a>
    </p>
  </article>
</ZxLayout>

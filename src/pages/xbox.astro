---
import ZxLayout from "../layouts/ZxLayout.astro";
import OfferGrid from "../components/zx/OfferGrid.astro";
import PlatformShowcase from "../components/zx/PlatformShowcase.astro";
import GuidesSection from "../components/zx/GuidesSection.astro";
import { getGuides, getOffers, xboxCategories } from "../data/catalog";

const offers = await getOffers();
const guides = await getGuides();
const xbOffers = offers.filter((offer) => offer.platform === "xbox");
const xbGuides = guides.filter((guide) => guide.tag === "Xbox" || guide.tag === "Comparativo");
---

<ZxLayout
  title="Xbox — Series X, Series S, Game Pass e ofertas | Zexy"
  description="Xbox Series X, Series S, controles, Game Pass e armazenamento com preços monitorados. As melhores ofertas do ecossistema Xbox."
>
  <section class="relative overflow-hidden pt-36 pb-16 md:pb-24">
    <div
      aria-hidden="true"
      class="pointer-events-none absolute inset-0 bg-[radial-gradient(55rem_32rem_at_50%_-10%,rgba(63,220,129,0.16),transparent_65%)]"
    >
    </div>
    <div class="zx-container relative text-center">
      <p data-hero-item class="zx-eyebrow">Ecossistema Xbox</p>
      <h1 data-hero-item class="zx-title mt-4 text-4xl sm:text-5xl md:text-6xl">
        Tudo para o seu <span class="text-zx-xb">Xbox</span>
      </h1>
      <p data-hero-item class="mx-auto mt-5 max-w-xl text-base leading-7 text-zx-muted sm:text-lg">
        Series X, Series S, controles, Game Pass e armazenamento pelo melhor valor do dia.
      </p>
      <div data-hero-item class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <a href="/ofertas" class="zx-btn-xb w-full sm:w-auto">Ver ofertas Xbox</a>
        <a href="/comparar" class="zx-btn-ghost w-full sm:w-auto">Comparar com PlayStation</a>
      </div>
    </div>
  </section>

  <section class="zx-container pb-4" aria-labelledby="xb-ofertas-titulo">
    <h2 id="xb-ofertas-titulo" class="zx-title text-2xl sm:text-3xl" data-reveal>Ofertas Xbox em destaque</h2>
    <div class="mt-8">
      <OfferGrid offers={xbOffers} />
    </div>
  </section>

  <PlatformShowcase
    platform="xbox"
    eyebrow="Categorias"
    title="Explore por categoria"
    description="Cada área do ecossistema Xbox com as ofertas do dia."
    categories={xboxCategories}
    ctaHref="/ofertas"
    ctaLabel="Ver todas as ofertas"
  />

  <GuidesSection guides={xbGuides} />

</ZxLayout>

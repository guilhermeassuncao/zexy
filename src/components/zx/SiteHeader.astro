---
import Logo from "./Logo.astro";

const navItems = [
  { label: "Início", href: "/" },
  { label: "PlayStation", href: "/playstation" },
  { label: "Nintendo", href: "/nintendo" },
  { label: "Xbox", href: "/xbox" },
  { label: "Comparar", href: "/comparar" },
  { label: "Ofertas", href: "/ofertas" },
  { label: "Notícias", href: "/noticias" }
];

const pathname = Astro.url.pathname.replace(/\/+$/, "") || "/";
---

<header data-zx-header class="fixed inset-x-0 top-0 z-40 transition-all duration-300">
  <div class="zx-container flex items-center justify-between gap-4 py-4">
    <a href="/" aria-label="Zexy — início" class="flex items-center">
      <Logo class="h-9" />
    </a>

    <nav aria-label="Menu principal" class="hidden items-center gap-1 lg:flex">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            aria-current={pathname === item.href ? "page" : undefined}
            class:list={[
              "rounded-full px-4 py-2 text-sm font-medium transition hover:bg-white/[0.07] hover:text-zx-ink focus-visible:outline focus-visible:outline-2 focus-visible:outline-zx-accent",
              pathname === item.href ? "bg-white/[0.08] text-zx-ink" : "text-zx-muted"
            ]}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2">
      <form action="/ofertas" method="get" role="search" class="hidden md:block">
        <label for="busca" class="sr-only">Buscar produtos</label>
        <input
          id="busca"
          type="search"
          name="q"
          placeholder="Buscar…"
          class="w-36 rounded-full border border-zx-line bg-white/[0.04] px-4 py-2 text-sm text-zx-ink placeholder:text-zx-muted focus:w-48 focus:border-zx-accent focus:outline-none transition-all duration-300 xl:w-44"
        />
      </form>

      <a href="/ofertas" class="zx-btn-primary hidden text-sm sm:inline-flex">Ver ofertas</a>

      <button
        type="button"
        data-zx-menu-toggle
        aria-expanded="false"
        aria-controls="zx-menu-mobile"
        class="inline-flex h-11 w-11 items-center justify-center rounded-full border border-zx-line text-zx-ink lg:hidden"
      >
        <span class="sr-only">Abrir menu</span>
        <svg data-icon-open width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <path d="M3 5h14M3 10h14M3 15h14" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" />
        </svg>
        <svg data-icon-close class="hidden" width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <path d="M5 5l10 10M15 5L5 15" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" />
        </svg>
      </button>
    </div>
  </div>

  <div
    id="zx-menu-mobile"
    data-zx-menu
    hidden
    class="border-t border-zx-line bg-zx-bg/95 backdrop-blur-xl lg:hidden"
  >
    <nav aria-label="Menu principal (celular)" class="zx-container flex flex-col gap-1 py-4">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            aria-current={pathname === item.href ? "page" : undefined}
            class:list={[
              "rounded-xl px-4 py-3 text-base font-medium transition hover:bg-white/[0.06]",
              pathname === item.href ? "bg-white/[0.08] text-zx-ink" : "text-zx-muted"
            ]}
          >
            {item.label}
          </a>
        ))
      }
      <form action="/ofertas" method="get" role="search" class="mt-2 md:hidden">
        <label for="busca-mobile" class="sr-only">Buscar produtos</label>
        <input
          id="busca-mobile"
          type="search"
          name="q"
          placeholder="Buscar produtos…"
          class="w-full rounded-xl border border-zx-line bg-white/[0.04] px-4 py-3 text-base text-zx-ink placeholder:text-zx-muted focus:border-zx-accent focus:outline-none"
        />
      </form>
      <a href="/ofertas" class="zx-btn-primary mt-2 w-full sm:hidden">Ver ofertas</a>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>("[data-zx-menu-toggle]");
  const menu = document.querySelector<HTMLElement>("[data-zx-menu]");
  const iconOpen = toggle?.querySelector("[data-icon-open]");
  const iconClose = toggle?.querySelector("[data-icon-close]");

  if (toggle && menu) {
    const setOpen = (open: boolean) => {
      toggle.setAttribute("aria-expanded", String(open));
      menu.hidden = !open;
      iconOpen?.classList.toggle("hidden", open);
      iconClose?.classList.toggle("hidden", !open);
    };

    toggle.addEventListener("click", () => setOpen(menu.hidden));
    menu.addEventListener("click", (event) => {
      if (event.target instanceof HTMLAnchorElement) setOpen(false);
    });
    document.addEventListener("keydown", (event) => {
      if (event.key !== "Escape" || menu.hidden) return;
      setOpen(false);
      // Devolve o foco ao botão para não perder o lugar no teclado.
      toggle.focus();
    });
  }
</script>

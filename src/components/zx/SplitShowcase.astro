---
// Seção scrollytelling reutilizável (consoles, controles, jogos…): no desktop
// a seção fica presa (pin via GSAP) enquanto a intro sai de cena, os lados
// entram das laterais/centro e os itens aparecem em fases. No mobile os blocos
// empilham com reveals simples. Aceita 2 ou 3 lados.
// A animação é dirigida por data-attributes lidos em src/scripts/zx-motion.ts.
import type { Platform } from "../../data/catalog";
import { platformLabels } from "../../data/catalog";

type SideImage = { src: string; alt: string; width: number; height: number };

export type ShowcaseSide = {
  platform: Platform;
  heading: string;
  image?: SideImage;
  imageClass?: string;
  covers?: Array<{ src: string; alt: string }>;
  items: string[];
  ctaLabel: string;
  ctaHref: string;
};

interface Props {
  id: string;
  eyebrow: string;
  title: string;
  description: string;
  sides: ShowcaseSide[];
}

const { id, eyebrow, title, description, sides } = Astro.props;
const headingId = `${id}-titulo`;

// Tokens por plataforma (cor da borda/glow do lado).
const theme: Record<Platform, { chip: string; btn: string; border: string; bg: string; shadow: string }> = {
  playstation: {
    chip: "zx-chip-ps",
    btn: "zx-btn-ps",
    border: "border-zx-ps/25",
    bg: "bg-zx-ps/[0.07]",
    shadow: "drop-shadow-[0_2rem_3rem_rgba(77,159,255,0.25)]"
  },
  nintendo: {
    chip: "zx-chip-nt",
    btn: "zx-btn-nt",
    border: "border-zx-nt/25",
    bg: "bg-zx-nt/[0.07]",
    shadow: "drop-shadow-[0_2rem_3rem_rgba(255,90,95,0.22)]"
  },
  xbox: {
    chip: "zx-chip-xb",
    btn: "zx-btn-xb",
    border: "border-zx-xb/25",
    bg: "bg-zx-xb/[0.07]",
    shadow: "drop-shadow-[0_2rem_3rem_rgba(63,220,129,0.22)]"
  }
};

const gridCols = sides.length >= 3 ? "md:grid-cols-3" : "md:grid-cols-2";
const maxW = sides.length >= 3 ? "max-w-6xl" : "max-w-4xl";
---

<section data-split class="relative overflow-hidden" aria-labelledby={headingId}>
  <div data-split-stage class="relative flex flex-col justify-center py-20 md:min-h-[100svh] md:pb-8 md:pt-28">
    <div aria-hidden="true" class="pointer-events-none absolute inset-0">
      <div class="absolute inset-y-0 left-0 w-1/2 bg-[radial-gradient(50rem_40rem_at_0%_50%,rgba(77,159,255,0.14),transparent_65%)]"></div>
      <div class="absolute inset-y-0 right-0 w-1/2 bg-[radial-gradient(50rem_40rem_at_100%_50%,rgba(63,220,129,0.12),transparent_65%)]"></div>
      {sides.length >= 3 && (
        <div class="absolute inset-x-1/4 inset-y-0 bg-[radial-gradient(40rem_40rem_at_50%_50%,rgba(255,90,95,0.1),transparent_65%)]"></div>
      )}
    </div>

    <div class="zx-container relative">
      <div class="md:pointer-events-none md:absolute md:inset-0 md:z-10 md:flex md:items-center md:justify-center">
        <div data-split-intro class="mx-auto max-w-2xl text-center">
          <p class="zx-eyebrow">{eyebrow}</p>
          <h2 id={headingId} class="zx-title mt-3 text-3xl sm:text-4xl md:text-5xl">{title}</h2>
          <p class="mt-4 text-base leading-7 text-zx-muted">{description}</p>
        </div>
      </div>

      <div class:list={["mx-auto mt-12 grid gap-14 md:mt-0 md:gap-10", maxW, gridCols]}>
        {
          sides.map((side, sideIndex) => {
            const t = theme[side.platform];
            return (
              <div data-split-side data-split-index={sideIndex} class="flex flex-col items-center text-center">
                {side.image && (
                  <img
                    src={side.image.src}
                    alt={side.image.alt}
                    width={side.image.width}
                    height={side.image.height}
                    loading="lazy"
                    decoding="async"
                    class:list={["w-auto object-contain", t.shadow, side.imageClass ?? "h-56 md:h-60"]}
                  />
                )}
                {side.covers && (
                  <div class="flex items-end justify-center">
                    {side.covers.map((cover, index) => (
                      <div data-split-item class:list={["shrink-0", index === 1 ? "z-10 -mx-5" : "z-0 translate-y-3"]}>
                        <img
                          src={cover.src}
                          alt={cover.alt}
                          width="600"
                          height="900"
                          loading="lazy"
                          decoding="async"
                          class:list={[
                            "rounded-xl border border-white/10 object-cover shadow-[0_1.5rem_3rem_rgba(0,0,0,0.5)]",
                            index === 1 ? "w-28 md:w-36" : "w-24 md:w-28",
                            index === 0 && "-rotate-6",
                            index === 2 && "rotate-6"
                          ]}
                        />
                      </div>
                    ))}
                  </div>
                )}
                <span class:list={[t.chip, "mt-6"]}>{platformLabels[side.platform]}</span>
                <h3 class="zx-title mt-3 text-2xl md:text-3xl">{side.heading}</h3>
                <ul class="mt-6 flex max-w-sm flex-wrap justify-center gap-2" aria-label={`Destaques ${side.heading}`}>
                  {side.items.map((item) => (
                    <li
                      data-split-item
                      class:list={["rounded-full border px-4 py-1.5 text-sm font-medium text-zx-ink", t.border, t.bg]}
                    >
                      {item}
                    </li>
                  ))}
                </ul>
                <div class="mt-7 md:mt-auto md:pt-7">
                  <a href={side.ctaHref} data-split-cta class={t.btn}>
                    {side.ctaLabel}
                  </a>
                </div>
              </div>
            );
          })
        }
      </div>
    </div>
  </div>
</section>

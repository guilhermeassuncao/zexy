---
import type { FeaturedItem } from "../data/home";
import { buildCloudinarySrcSet, optimizeCloudinaryImage } from "../utils/images";

interface Props {
  item: FeaturedItem;
  priority?: boolean;
}

const { item, priority = false } = Astro.props;
const imageSrc = optimizeCloudinaryImage(item.image, { width: priority ? 960 : 720 });
const imageSrcSet = buildCloudinarySrcSet(item.image, priority ? [480, 720, 960, 1200] : [360, 540, 720, 960]);
const imageSizes =
  item.size === "large"
    ? "(max-width: 48.75rem) 100vw, (max-width: 64rem) 92vw, 620px"
    : item.size === "medium"
      ? "(max-width: 48.75rem) 100vw, (max-width: 64rem) 92vw, 460px"
      : "(max-width: 48.75rem) 100vw, (max-width: 64rem) 92vw, 320px";

const categoryMap = {
  games: {
    text: "text-red",
    stripe: "bg-red"
  },
  animes: {
    text: "text-purple",
    stripe: "bg-purple"
  },
  series: {
    text: "text-orange",
    stripe: "bg-orange"
  }
} as const;

const sizeMap = {
  large: "min-h-[32.8125rem] max-md:min-h-[22rem]",
  medium: "min-h-[15.8125rem] max-md:min-h-[13rem]",
  small: "min-h-[10.0625rem] max-md:min-h-[9.5rem]"
} as const;

const categoryLabelMap = {
  games: "games",
  animes: "animes",
  series: "series & filmes"
} as const;
---

<article
  class:list={[
    "group relative flex items-end overflow-hidden rounded-[0.625rem] bg-black/20 transition duration-300 ease-out hover:z-10 hover:scale-[1.06] hover:shadow-panel",
    sizeMap[item.size]
  ]}
>
  <img
    src={imageSrc}
    srcset={imageSrcSet}
    sizes={imageSizes}
    alt=""
    aria-hidden="true"
    width="1200"
    height="675"
    loading={priority ? "eager" : "lazy"}
    decoding="async"
    fetchpriority={priority ? "high" : "auto"}
    class="absolute inset-0 h-full w-full object-cover"
  />
  <a href={item.href} class="absolute inset-0 z-10 block" aria-label={item.title}>
    <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent transition duration-300 group-hover:from-black/70 group-hover:via-black/10"></div>
    <span class:list={["absolute bottom-0 left-0 h-[5.75rem] w-2", categoryMap[item.category].stripe]}></span>
    <div class="absolute inset-x-0 bottom-0 p-5 transition duration-300 group-hover:translate-y-[-0.125rem]">
      <span class:list={["mb-2.5 inline-flex items-center gap-2 text-xs font-bold uppercase tracking-[0.06em]", categoryMap[item.category].text]}>
        {categoryLabelMap[item.category]}
        <span class:list={["h-[0.6875rem] w-[0.6875rem] rounded-sm", categoryMap[item.category].stripe]}></span>
      </span>
      <h2 class="max-w-[32.5rem] text-base font-extrabold leading-tight text-white transition duration-300 group-hover:text-white/95 max-md:text-sm">
        {item.title}
      </h2>
    </div>
  </a>
</article>

---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: "website" | "article";
  author?: string;
  publishedTime?: string;
  modifiedTime?: string;
  robots?: string;
  structuredData?: Record<string, unknown> | Array<Record<string, unknown>>;
  enablePostCarousel?: boolean;
  bodyClass?: string;
}

const {
  title = "Zexy",
  description = "Portal independente para comparar consoles, acessórios e ofertas de PlayStation e Xbox em um só lugar.",
  image = `${import.meta.env.BASE_URL}og-image.png`,
  type = "website",
  author = "Guilherme Assunção e Letícia Dias",
  publishedTime,
  modifiedTime,
  robots = "index, follow, max-image-preview:large",
  structuredData,
  enablePostCarousel = false,
  bodyClass = "bg-site-gradient pt-[5.625rem] max-md:pt-0"
} = Astro.props;
const baseUrl = import.meta.env.BASE_URL;
const site = Astro.site ?? new URL("https://zexy.com.br");
const canonicalUrl = new URL(Astro.url.pathname, site).toString();
const imageUrl = image.startsWith("http") ? image : new URL(image, site).toString();
const siteStructuredData = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "Zexy",
  url: site.toString(),
  inLanguage: "pt-BR"
};
const structuredDataEntries = [
  siteStructuredData,
  ...(structuredData ? (Array.isArray(structuredData) ? structuredData : [structuredData]) : [])
];
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preconnect" href="https://res.cloudinary.com" crossorigin />
    <link rel="dns-prefetch" href="https://res.cloudinary.com" />
    <link rel="icon" type="image/svg+xml" href={`${baseUrl}favicon.svg`} />
    <link rel="canonical" href={canonicalUrl} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta name="author" content={author} />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Zexy" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta property="article:author" content={author} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:creator" content={author} />
    <script type="application/ld+json" set:html={JSON.stringify(structuredDataEntries)}></script>
    <slot name="head" />
  </head>
  <body class={bodyClass}>
    <slot />

    {
      enablePostCarousel && (
        <script is:inline>
          const initPostCarousels = () => {
            document.querySelectorAll("[data-post-carousel]").forEach((carousel) => {
              if (!(carousel instanceof HTMLElement)) return;

              const track = carousel.querySelector("[data-post-carousel-track]");
              const prev = carousel.querySelector("[data-post-carousel-prev]");
              const next = carousel.querySelector("[data-post-carousel-next]");
              const dots = Array.from(carousel.querySelectorAll("[data-post-carousel-dot]"));

              if (!(track instanceof HTMLElement)) return;

              const getSlideWidth = () => track.clientWidth;
              const getIndex = () => {
                const width = getSlideWidth();
                if (!width) return 0;
                return Math.round(track.scrollLeft / width);
              };

              const updateDots = () => {
                const activeIndex = getIndex();
                dots.forEach((dot, index) => {
                  dot.classList.toggle("is-active", index === activeIndex);
                });
              };

              const scrollToIndex = (index) => {
                const maxIndex = Math.max(dots.length - 1, 0);
                const targetIndex =
                  index < 0 ? maxIndex : index > maxIndex ? 0 : Math.min(Math.max(index, 0), maxIndex);

                track.scrollTo({
                  left: targetIndex * getSlideWidth(),
                  behavior: "smooth"
                });
              };

              prev?.addEventListener("click", () => scrollToIndex(getIndex() - 1));
              next?.addEventListener("click", () => scrollToIndex(getIndex() + 1));

              dots.forEach((dot, index) => {
                dot.addEventListener("click", () => scrollToIndex(index));
              });

              track.addEventListener("scroll", updateDots, { passive: true });
              window.addEventListener("resize", updateDots, { passive: true });
              updateDots();
            });
          };

          if ("requestIdleCallback" in window) {
            window.requestIdleCallback(initPostCarousels, { timeout: 1200 });
          } else {
            window.addEventListener("load", initPostCarousels, { once: true });
          }
        </script>
      )
    }
    <script is:inline>
      const initLiteYouTube = () => {
        document.querySelectorAll("[data-lite-youtube]").forEach((container) => {
          if (!(container instanceof HTMLElement) || container.dataset.bound === "true") return;

          const button = container.querySelector(".lite-youtube-button");
          const embed = container.dataset.embed;
          const label = container.getAttribute("aria-label") ?? "Trailer";

          if (!(button instanceof HTMLButtonElement) || !embed) return;

          container.dataset.bound = "true";

          button.addEventListener("click", () => {
            const iframe = document.createElement("iframe");
            iframe.src = embed;
            iframe.title = label;
            iframe.loading = "eager";
            iframe.allow = "accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share";
            iframe.allowFullscreen = true;
            iframe.className = "h-full w-full rounded-none border-0";
            container.replaceChildren(iframe);
          });
        });
      };

      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", initLiteYouTube, { once: true });
      } else {
        initLiteYouTube();
      }
    </script>
  </body>
</html>
